# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / frontend build
frontend/node_modules/
frontend/dist/

# Local env files — NEVER commit (hold DB hosts, logins, passwords).
.env
*.env
.env.*
*.env.*
!*.env.sample
!*.env.example

.databricks/

# Per-user bundle deploy targets (workspace-specific); keep target.yml.sample
target.yml

# Local credentials / scratch notes — NEVER commit (holds DB hosts + passwords)
sqladmin.md
*.secrets.md
.databrickscfg

# Local test fixtures that write to a real source database — kept out of the
# repo so nobody runs them against a database they did not mean to.
scripts/*_demo_source.py

# Build artifacts
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Claude Code local settings
.claude/
.local-backup/
.isaac/config.json
.DS_Store

# From the databricks-solutions scaffold
*conf*.json
# ...but that pattern also matches tsconfig.json, which the frontend needs
# tracked. Vite projects add tsconfig.node.json / tsconfig.app.json too.
!tsconfig*.json
.idea/
