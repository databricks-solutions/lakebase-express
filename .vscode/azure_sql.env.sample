# Config for the Azure SQL probe debug configuration in .vscode/launch.json.
# Copy to .vscode/azure_sql.env (gitignored) and fill in.
#
# The probe parses this file itself. Bare or quoted values work; additional
# equals signs and hash characters after the first equals sign stay in the
# value, which is important for passwords.

LBX_SRC_HOST=<server>.database.windows.net
LBX_SRC_DATABASE=<db>
LBX_SRC_USER=<login>

# Only for the env-file configuration. The prompt-for-password and
# secret-scope configurations supply the password themselves.
LBX_SRC_PASSWORD=

# Optional
# LBX_SRC_PORT=1433
# LBX_SRC_TYPE=azure-sql
